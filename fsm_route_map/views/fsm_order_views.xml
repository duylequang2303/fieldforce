<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fsm_order_form_inherit_route" model="ir.ui.view">
        <field name="name">fsm.order.form.inherit.route.map</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info" invisible="not route_id">
                    Đơn này thuộc lộ trình: <field name="route_id" readonly="1" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
